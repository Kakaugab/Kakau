using System;

class Program
{
    static void Main()
    {
        Stack<int> pilha = new Stack<int>();
        Stack<int> auxiliar = new Stack<int>();

        Console.Write("Quantos números deseja inserir? ");
        int quantidade = int.Parse(Console.ReadLine());

        for (int i = 0; i < quantidade; i++)
        {
            Console.Write("Digite um número: ");
            int numero = int.Parse(Console.ReadLine());

            pilha.Push(numero);
        }

        while (pilha.Count > 0)
        {
            int temp = pilha.Pop();

            while (auxiliar.Count > 0 && auxiliar.Peek() < temp)
            {
                pilha.Push(auxiliar.Pop());
            }

            auxiliar.Push(temp);
        }

        Console.WriteLine("\nPilha ordenada (menor no topo):");

        while (auxiliar.Count > 0)
        {
            Console.WriteLine(auxiliar.Pop());
        }
    }
}

