using System;

class Program
{
    static int Precedencia(string operador)
    {
        if (operador == "+" || operador == "-")
            return 1;

        if (operador == "*" || operador == "/")
            return 2;

        return 0;
    }

    static int AplicarOperacao(int a, int b, string operador)
    {
        switch (operador)
        {
            case "+":
                return a + b;

            case "-":
                return a - b;

            case "*":
                return a * b;

            case "/":
                return a / b;

            default:
                return 0;
        }
    }

    static void Main()
    {
        Stack<int> operandos = new Stack<int>();
        Stack<string> operadores = new Stack<string>();

        Console.Write("Digite a expressão: ");
        string expressao = Console.ReadLine();

        string[] tokens = expressao.Split(' ');

        foreach (string token in tokens)
        {
            if (int.TryParse(token, out int numero))
            {
                operandos.Push(numero);
            }
            else
            {
                while (operadores.Count > 0 &&
                       Precedencia(operadores.Peek()) >= Precedencia(token))
                {
                    int b = operandos.Pop();
                    int a = operandos.Pop();

                    string op = operadores.Pop();

                    int resultado = AplicarOperacao(a, b, op);

                    operandos.Push(resultado);
                }

                operadores.Push(token);
            }
        }

        while (operadores.Count > 0)
        {
            int b = operandos.Pop();
            int a = operandos.Pop();

            string op = operadores.Pop();

            int resultado = AplicarOperacao(a, b, op);

            operandos.Push(resultado);
        }

        Console.WriteLine("Resultado: " + operandos.Pop());
    }
}
